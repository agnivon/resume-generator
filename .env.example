# Application Site URL (Optional override for custom domains; falls back to Vercel System Environment Variables)
NEXT_PUBLIC_SITE_URL="https://your-domain.vercel.app"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret"

# OAuth Providers
GOOGLE_ID="your-google-client-id"
GOOGLE_SECRET="your-google-client-secret"

GITHUB_ID="your-github-client-id"
GITHUB_SECRET="your-github-client-secret"

FACEBOOK_ID="your-facebook-client-id"
FACEBOOK_SECRET="your-facebook-client-secret"

# Database Configuration
DATABASE_URL="mongodb://localhost:27017/resume-generator"

# OpenAI Key
OPENAI_API_KEY="your-openai-api-key"
